u0651\u064e \u062c\u0650\u062f\u0627\u0644\u064b\u0627 \u0641\u064a\u0647 \u0643\u064f\u0641\u0631\u064c\u00bb.","explanation_ar":"\u0646\u0647\u0649 \u0627\u0644\u0646\u0628\u064a \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645 \u0639\u0646 \u0627\u0644\u062c\u062f\u0627\u0644 \u0641\u064a \u0627\u0644\u0642\u0631\u0622\u0646\u061b \u0644\u0623\u0646\u0647 \u064a\u0624\u062f\u064a \u0625\u0644\u0649 \u0643\u0641\u0631\u061b \u0648\u0630\u0644\u0643 \u0644\u0623\u0646 \u0627\u0644\u0625\u0646\u0633\u0627\u0646 \u0642\u062f \u064a\u0633\u0645\u0639 \u0642\u0631\u0627\u0621\u0629 \u0622\u064a\u0629 \u0623\u0648 \u0643\u0644\u0645\u0629 \u0644\u0645 \u062a\u0643\u0646 \u0639\u0646\u062f\u0647\u060c \u0648\u0644\u0627 \u0639\u0644\u0645 \u0644\u0647 \u0628\u0647\u0627 \u0641\u064a\u062a\u0633\u0631\u0639 \u0648\u064a\u062e\u0637\u0651\u0650\u0626 \u0627\u0644\u0642\u0627\u0631\u0626 \u0648\u064a\u0646\u0633\u0650\u0628 \u0645\u0627 \u064a\u0642\u0631\u0624\u0647 \u0625\u0644\u0649 \u0623\u0646\u0647 \u063a\u064a\u0631 \u0642\u0631\u0622\u0646\u060c \u0623\u0648 \u064a\u062c\u0627\u062f\u0644\u0647 \u0641\u064a \u0645\u0639\u0646\u0649 \u0622\u064a\u0629 \u0644\u0627 \u0639\u0644\u0645 \u0644\u0647 \u0628\u0647\u0627 \u0648\u064a\u0636\u0644\u0644\u0647\u060c \u0648\u0627\u0644\u062c\u062f\u0627\u0644 \u0631\u0628\u0645\u0627 \u0635\u0631\u0641\u0647 \u0639\u0646 \u0627\u0644\u062d\u0642 \u0648\u0625\u0646 \u0638\u0647\u0631 \u0644\u0647 \u0648\u062c\u0647\u0647\u060c \u0641\u0644\u0630\u0644\u0643 \u062d\u064f\u0631\u0651\u0650\u0645 \u0648\u0633\u064f\u0645\u0651\u0650\u064a \u0643\u0641\u0631\u064b\u0627\u061b \u0644\u0623\u0646\u0647 \u064a\u0624\u062f\u064a \u0628\u0635\u0627\u062d\u0628\u0647 \u0625\u0644\u0649 \u0627\u0644\u0643\u0641\u0631\u060c \u0648\u0645\u062a\u0649 \u0633\u0644\u0645 \u0627\u0644\u0625\u0646\u0633\u0627\u0646 \u0645\u0646 \u0630\u0644\u0643 \u0643\u0644\u0647 \u0641\u0647\u0648 \u0645\u0628\u0627