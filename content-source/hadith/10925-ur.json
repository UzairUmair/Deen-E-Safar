8\u0628 \u0627\u0644\u0633\u0651\u064f\u062c\u0648\u062f \u0641\u064a \u0627\u0644\u0635\u0644\u0627\u0629 \u0639\u0644\u0649 \u0627\u0644\u0623\u0639\u064e\u0636\u0627\u0621 \u0627\u0644\u0633\u0651\u064e\u0628\u0639\u0629.","\u0643\u0631\u0627\u0647\u064a\u0629 \u062c\u064e\u0645\u0652\u0639\u0650 \u0648\u0636\u064e\u0645\u0651\u0650 \u0627\u0644\u062b\u0651\u064e\u0648\u0628 \u0648\u0627\u0644\u0634\u0651\u064e\u0639\u064e\u0631 \u0641\u064a \u0627\u0644\u0635\u0644\u0627\u0629.","\u064a\u062c\u0628 \u0639\u0644\u0649 \u0627\u0644\u0645\u0635\u0644\u064a \u0623\u0646 \u064a\u0637\u0645\u0626\u0646 \u0641\u064a \u0635\u0644\u0627\u062a\u0647\u060c \u0648\u0630\u0644\u0643 \u0628\u0623\u0646\u0652 \u064a\u0636\u0639 \u0623\u0639\u0636\u0627\u0621 \u0627\u0644\u0633\u062c\u0648\u062f \u0627\u0644\u0633\u0628\u0639\u0629 \u0639\u0644\u0649 \u0627\u0644\u0623\u0631\u0636\u060c \u0648\u064a\u0633\u062a\u0642\u0631 \u0639\u0644\u064a\u0647\u0627 \u062d\u062a\u0649 \u064a\u0623\u062a\u064a \u0628\u0627\u0644\u0630\u0643\u0631 \u0627\u0644\u0645\u0634\u0631\u0648\u0639.","\u0627\u0644\u0646\u0647\u064a\u064f \u0639\u0646 \u0643\u064e\u0641\u0651\u0650 \u0627\u0644\u0634\u0651\u064e\u0639\u064e\u0631\u0650 \u062e\u0627\u0635\u0651\u064c \u0628\u0627\u0644\u0631\u062c\u0627\u0644 \u062f\u0648\u0646 \u0627\u0644\u0646\u0633\u0627\u0621\u061b \u0644\u0623\u0646 \u0627\u0644\u0645\u0631\u0623\u0629 \u0641\u064a \u0627\u0644\u0635\u0644\u0627\u0629 \u0645\u0623\u0645\u0648\u0631\u0629 \u0628\u0627\u0644\u062a\u0633\u062a\u0631."],"words_meanings_ar":[{"word":"\u0648\u0644\u0627 \u0646\u064e\u0643\u0652\u0641\u0650\u062a","meaning":" \u0627\u0644\u0643\u064e\u0641\u062a: \u0627\u0644\u062c\u064e\u0645\u0639 \u0648\u0627\u0644\u0636\u0651\u064e\u0645."}],"attribution_ar":"\u0645\u062a\u0641\u0642 \u0639\u0644\u064a\u0647","grade_ar":"\u0635\u062d\u064a\u062d"}