b\u0627 \u0623\u062d\u0633\u0646 \u0645\u0646 \u062a\u0633\u0648\u0643\u0647.\n\u0641\u0644\u0645\u0627 \u0637\u0647\u0631 \u0648\u0641\u0631\u063a \u0645\u0646 \u0627\u0644\u062a\u0633\u0648\u0643\u060c \u0631\u0641\u0639 \u0625\u0635\u0628\u0639\u0647\u060c \u064a\u0648\u062d\u062f \u0627\u0644\u0644\u0647 \u062a\u0639\u0627\u0644\u0649 \u060c \u0648\u064a\u062e\u062a\u0627\u0631 \u0627\u0644\u0646\u0642\u0644\u0629 \u0625\u0644\u0649 \u0631\u0628\u0647 \u062a\u0639\u0627\u0644\u0649 \u060c \u062b\u0645 \u062a\u0648\u0641\u064a \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645 .\n\u0641\u0643\u0627\u0646\u062a \u0639\u0627\u0626\u0634\u0629 \u0631\u0636\u064a \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0627 \u0645\u063a\u062a\u0628\u0637\u0629\u060c \u0648\u062d\u064f\u0642 \u0644\u0647\u0627 \u0630\u0644\u0643\u060c \u0628\u0623\u0646\u0647 \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645 \u062a\u0648\u0641\u064a \u0648\u0631\u0623\u0633\u0647 \u0639\u0644\u0649 \u0635\u062f\u0631\u0647\u0627.","hints_ar":["\u062c\u0648\u0627\u0632 \u0627\u0644\u0627\u0633\u062a\u064a\u0627\u0643 \u0628\u0627\u0644\u0633\u0648\u0627\u0643 \u0627\u0644\u0631\u0637\u0628.","\u0645\u062d\u0628\u0629 \u0627\u0644\u0646\u0628\u064a -\u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645- \u0644\u0644\u0633\u0648\u0627\u0643.","\u0642\u0648\u0629 \u0641\u0637\u0646\u0629 \u0639\u0627\u0626\u0634\u0629 -\u0631\u0636\u064a \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0627-.","\u0627\u0644\u0639\u0645\u0644 \u0628\u0645\u0627 \u064a\u0641\u0647\u0645 \u0645\u0646 \u0627\u0644\u0625\u0634\u0627\u0631\u0629 \u0648\u0627\u0644\u062f\u0644\u0627\u0644\u0629.","\u0625\u0635\u0644\u0627\u062d \u0627\u0644\u0633\u0648\u0627\u0643 \u0648\u062a\u0647\u064a\u0626\u062a\u0647.","\u062c\u0648\u0627\u0632 \u0627\u0644\u0627\u0633\u062a\u064a\u0627\u0643 \u0628\u0633\u0648\u0627\u0643 \u0627\u0644\u063a\u064a\u0631 \u0628\u0639\u062f \u062a\u0637\u0647\u064a\u0631\u0647 \u0648\u062a\u0646\u0638\u064a\u0641\u0647.","\u062a\u0648\u0643\u064a\u062f \u0623\u0645\u0631 \u0627\u0644\u0633\u0648\u0627\u0643 \u0644\u0643\u0648\u0646\u0647 -\u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645- \u062d\u0631\u0635 \u0639\u0644\u064a\u0647 \u0645\u0639 \u0645\u0627 \u0647\u0648 \u0641\u064a\u0647 \u0645\u0646 \u062a\u0639\u0628 \u0627\u0644\u0645\u0631\u0636.","\u0642\u0648\u0629 \u0642\u0644\u0628 \u0627\u0644\u0646\u0628\u064a -\u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645- \u0648\u0631\u0628\u0627\u0637\u0629 \u062c\u0623\u0634\u0647 \u062d\u064a\u062b \u0644\u0645 \u064a\u0630\u0647\u0644 \u0639\u0646 \u0627\u0644\u062a\u0633\u0648\u0651\u064f\u0643 \u0648\u0627\u0644\u062f\u0639\u0627\u0621 \u062d\u0627\u0644 \u0627\u0644\u0645\u0648\u062a.","\u0627\u0633\u062a\u062d\u0628\u0627\u0628 \u0627\u0644\u0627\u0633\u062a\u064a\u0627\u0643 \u0639\u0646\u062f \u0627\u0644\u0627\u062d\u062a\u0636\u0627\u0631.","\u0625\u062b\u0628\u0627\u062a \u0639\u0644\u0648 \u0627\u0644\u0644\u0647 -\u0639\u0632 \u0648\u062c\u0644- \u0641\u064a \u0627\u0644\u0633\u0645\u0627\u0621.","\u0641\u0636\u064a\u0644\u0629 \u0639\u0627\u0626\u0634\u0629 -\u0631\u0636\u064a \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0627- \u0648\u0648\u0641\u0627\u062a\u0647 -\u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645- \u0641\u064a \u062d\u0650\u062c\u0631\u0647\u0627\u060c \u0648\u0628\u064a\u062a\u0647\u0627\u060c \u0648\u064a\u0648\u0645\u0647\u0627."],"words_meanings_ar":[{"word":"\u0645\u064f\u0633\u0652\u0646\u0650\u062f\u064e\u062a\u064f\u0647","meaning":" \u0645\u0645\u064a\u0644\u062a\u0647."},{"word":"\u0627\u0644\u0631\u0637\u0628","meaning":" \u0636\u062f \u0627\u0644\u064a\u0627\u0628\u0633\u060c \u0648\u064a\u0635\u062f\u0642 \u0639\u0644\u0649 \u0627\u0644\u0623\u062e\u0636\u0631 \u0648\u0627\u0644\u0645\u0646\u062f\u0649."},{"word":"\u064a\u064e\u0633\u062a\u064e\u0646\u0651\u064f \u0628\u0647","meaning":" \u064a\u064f\u0645\u0650\u0631\u0651\u064f \u0627\u0644\u0633\u0648\u0627\u0643 \u0639\u0644\u0649 \u0623\u0633\u0646\u0627\u0646\u0647\u060c \u0643\u0623\u0646\u0647 \u064a\u062d\u062f\u062f\u0647\u0627."},{"word":"\u0641\u0623\u064e\u0628\u064e\u062f\u0651\u064e\u0647","meaning":" \u0645\u062f\u0651\u064e \u0625\u0644\u064a\u0647 \u0628\u0635\u0631\u0647 \u0648\u0623\u0637\u0627\u0644\u0647."},{"word":"\u0628\u064a\u0646 \u062d\u064e\u0627\u0642\u0650\u0646\u064e\u062a\u0650\u064a \u0648\u0630\u064e\u0627\u0642\u0650\u0646\u064e\u062a\u0650\u064a","meaning":" \u0627\u0644\u062d\u0627\u0642\u0646\u0629: \u0647\u064a \u0627\u0644\u0645\u0639\u062f\u0629 \u0623\u0648 \u0623\u0633\u0641\u0644 \u0627\u0644\u0628\u0637\u0646\u060c \u0648\u0627\u0644\u0630\u0627\u0642\u0646\u0629: \u0645\u0627 \u062a\u062d\u062a \u0627\u0644\u0630\u0642\u0646 \u0648\u0631\u0623\u0633 \u0627\u0644\u062d\u0644\u0642\u0648\u0645."},{"word":"\u0641\u0642\u064e\u0636\u064e\u0645\u062a\u0647","meaning":" \u0645\u0636\u063a\u062a\u0647 \u0628\u0623\u0637\u0631\u0627\u0641 \u0627\u0644\u0623\u0633\u0646\u0627\u0646\u061b \u0644\u0650\u064a\u064e\u0644\u0650\u064a\u0646."},{"word":"\u0633\u0648\u0627\u0643","meaning":" \u0645\u0633\u0648\u0627\u0643 \u0645\u0646 \u0627\u0644\u062c\u0631\u064a\u062f \u0627\u0644\u0623\u062e\u0636\u0631."},{"word":"\u0637\u064a\u0651\u064e\u0628\u062a\u064f\u0647","meaning":" \u062c\u0639\u0644\u062a\u0647 \u0637\u064a\u0628\u0627 \u0635\u0627\u0644\u062d\u0627\u061b \u0644\u0644\u062a\u0633\u0648\u0643 \u0628\u0647."},{"word":"\u0641\u0645\u0627 \u0639\u064e\u062f\u064e\u0627 \u0623\u0646 \u0641\u064e\u0631\u064e\u063a \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647 -\u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645- \u0631\u064e\u0641\u064e\u0639","meaning":" \u0645\u0627 \u062c\u0627\u0648\u0632\u060c \u0648\u0641\u0631\u063a: \u0627\u0646\u062a\u0647\u0649\u060c \u0648\u0627\u0644\u0645\u0639\u0646\u0649: \u0645\u0627 \u062c\u0627\u0648\u0632 \u0641\u0631\u0627\u063a\u0647 \u0645\u0646 \u0627\u0644\u062a\u0633\u0648\u0643 \u062d\u062a\u0649 \u0631\u0641\u0639\u060c \u0623\u064a: \u0623\u0646\u0647 \u0628\u0627\u062f\u0631 \u0628\u0630\u0644\u0643."},{"word":"\u0627\u0644\u0631\u0641\u064a\u0642","meaning":" \u0627\u0644\u0645\u0631\u0627\u0641\u0642."},{"word":"\u0648\u0627\u0644\u0623\u0639\u0644\u0649","meaning":" \u0635\u0641\u0629 \u0644\u0644\u0631\u0641\u064a\u0642\u060c \u0648\u0647\u0648 \u0627\u0644\u0623\u0631\u062c\u062d\u061b \u0644\u0623\u0646 \u0627\u0644\u0631\u0633\u0644 \u0623\u0639\u0644\u0649 \u0627\u0644\u062e\u0644\u0642 \u0641\u0636\u0644\u0627 \u0648\u0645\u0646\u0632\u0644\u0629."},{"word":"\u0642\u0636\u0649","meaning":" \u0645\u0627\u062a."},{"word":"\u0623\u0634\u0627\u0631 \u0628\u0631\u0623\u0633\u0647","meaning":" \u0623\u0648\u0645\u0623 \u0628\u0647."}],"attribution_ar":"\u0631\u0648\u0627\u0647 \u0627\u0644\u0628\u062e\u0627\u0631\u064a","grade_ar":"\u0635\u062d\u064a\u062d"}