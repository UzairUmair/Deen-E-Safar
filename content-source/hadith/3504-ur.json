0632\u0627\u062f \u0623\u0628\u0648 \u062f\u0627\u0648\u062f: \u00ab\u0641\u064a\u0642\u0648\u0644 -\u064a\u0639\u0646\u064a: \u0627\u0644\u0634\u064a\u0637\u0627\u0646- \u0644\u0650\u0634\u064e\u064a\u0637\u0627\u0646 \u0622\u062e\u0631: \u0643\u064e\u064a\u0641 \u0644\u064e\u0643 \u0628\u0650\u0631\u064e\u062c\u0644\u064d \u0642\u064e\u062f \u0647\u064f\u062f\u0650\u064a\u064e \u0648\u0643\u064f\u0641\u0650\u064a\u064e \u0648\u0648\u064f\u0642\u0650\u064a\u064e\u061f\u00bb.","explanation_ar":"\u0623\u062e\u0628\u0631 \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647 \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645 \u0623\u0646 \u0627\u0644\u0631\u062c\u0644 \u0625\u0630\u0627 \u062e\u0631\u062c \u0645\u0646 \u0628\u064a\u062a\u0647 \u0641\u0642\u0627\u0644: \u0628\u0627\u0633\u0645 \u0627\u0644\u0644\u0647\u060c \u062a\u0648\u0643\u0644\u062a \u0639\u0644\u0649 \u0627\u0644\u0644\u0647\u060c \u0644\u0627 \u062d\u0648\u0644 \u0648\u0644\u0627 \u0642\u0648\u0629 \u0625\u0644\u0627 \u0628\u0627\u0644\u0644\u0647\u060c \u064a\u0646\u0627\u062f\u064a\u0647 \u0645\u0644\u0643 \u064a\u0627 \u0639\u0628\u062f \u0627\u0644\u0644\u0647 \u0647\u062f\u064a\u062a \u0625\u0644\u0649 \u0637\u0631\u064a\u0642 \u0627\u0644\u062d\u0642\u060c \u0648\u0643\u0641\u064a\u062a \u0647\u0645\u0643\u060c \u0648\u062d\u0641\u0638\u062a \u0645\u0646 \u0627\u0644\u0623\u0639\u062f\u0627\u0621\u061b \u0641\u064a\u0628\u062a\u0639\u062f \u0639\u0646\u0647 \u0627\u0644\u0634\u064a\u0637\u0627\u0646 \u0627\u0644\u0645\u0648\u0643\u0644 \u0639\u0644\u064a\u0647\u060c \u0641\u064a\u0642\u0648\u0644 \u0634\u064a\u0637\u0627\u0646 \u0622\u062e\u0631 \u0644\u0647\u0630\u0627 \u0627\u0644\u0634\u064a\u0637\u0627\u0646: \u0643\u064a\u0641 \u0644\u0643 \u0628\u0625\u0636\u0644\u0627\u0644 \u0631\u062c\u0644 \u0642\u062f \u0647\u062f\u064a\u060c \u0648\u0643\u0641\u064a\u060c \u0648\u0648\u0642\u064a \u0645\u0646 \u0627\u0644\u0634\u064a\u0627\u0637\u064a\u0646 \u0623\u062c\u0645\u0639\u064a\u0646\u061f \u0644\u0623\u0646\u0647 \u0642\u0627\u0644 \u0647\u0630\u0647 \u0627\u0644\u0643\u0644\u0645\u0627\u062a \u0641\u0625\u0646\u0643 \u0644\u0627 \u062a\u0642\u062f\u0631 \u0639\u0644\u064a\u0647.","hints_ar":["\u0627\u0633\u062a\u062d\u0628\u0627\u0628 \u0647\u0630\u0627 \u0627\u0644\u0642\u0648\u0644 \u0639\u0646\u062f \u0627\u0644\u062e\u0631\u0648\u062c \u0645\u0646 \u0627\u0644\u0645\u0646\u0632\u0644\u061b \u0644\u064a\u062d\u0635\u0644 \u0645\u0627 \u0641\u064a\u0647 \u0645\u0646 \u062e\u064a\u0631.","\u0641\u0636\u0644 \u0627\u0644\u062a\u0648\u0643\u0644 \u0639\u0644\u0649 \u0627\u0644\u0644\u0647 -\u0639\u0632 \u0648\u062c\u0644-\u060c \u0648\u0627\u0644\u0627\u0644\u062a\u062c\u0627\u0621 \u0625\u0644\u064a\u0647 \u0628\u0627\u0644\u0642\u0648\u0644 \u0648\u0627\u0644\u0641\u0639\u0644\u060c \u0648\u0623\u0646 \u0630\u0644\u0643 \u062d\u0635\u0646 \u0644\u0644\u0645\u0624\u0645\u0646 \u0645\u0646 \u0643\u0644 \u0634\u0631.","\u0644\u0627 \u062d\u0648\u0644 \u0648\u0644\u0627 \u0642\u0648\u0629 \u0644\u0644\u0639\u0628\u062f \u0641\u064a \u0643\u0627\u0641\u0629 \u0623\u0645\u0648\u0631\u0647 \u0625\u0644\u0627 \u0628\u0627\u0644\u0644\u0647.","\u0639\u062c\u0632 \u0627\u0644\u0634\u064a\u0637\u0627\u0646 \u0639\u0646 \u063a\u0648\u0627\u064a\u0629 \u0645\u0646 \u0647\u062f\u0627\u0647 \u0627\u0644\u0644\u0647\u060c \u0648\u062d\u0628\u0651\u064e\u0628 \u0625\u0644\u064a\u0647 \u0627\u0644\u0625\u064a\u0645\u0627\u0646 \u0648\u0632\u064a\u0646\u0647 \u0641\u064a \u0642\u0644\u0628\u0647.","\u062a\u0639\u0627\u0648\u0646 \u0627\u0644\u0634\u064a\u0627\u0637\u064a\u0646 \u0644\u0625\u0636\u0644\u0627\u0644 \u0627\u0644\u0639\u0628\u0627\u062f."],"words_meanings_ar":[{"word":"\u062a\u064e\u0648\u064e\u0643\u0651\u064e\u0644\u062a","meaning":" \u0627\u0644\u062a\u0648\u0643\u0644 \u0647\u0648: \u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f \u0639\u0644\u0649 \u0627\u0644\u0644\u0647 -\u0633\u0628\u062d\u0627\u0646\u0647 \u0648\u062a\u0639\u0627\u0644\u0649- \u0641\u064a \u062d\u0635\u0648\u0644 \u0627\u0644\u0645\u0637\u0644\u0648\u0628\u060c \u0648\u062f\u0641\u0639 \u0627\u0644\u0645\u0643\u0631\u0648\u0647 \u060c \u0645\u0639 \u0627\u0644\u062b\u0642\u0629 \u0628\u0647 \u0648\u0641\u0639\u0644 \u0627\u0644\u0623\u0633\u0628\u0627\u0628 \u0627\u0644\u0645\u0623\u0630\u0648\u0646 \u0641\u064a\u0647\u0627."},{"word":"\u0644\u0627\u064e \u062d\u0648\u0644 \u0648\u0644\u0627 \u0642\u064f\u0648\u0651\u064e\u0629 \u0625\u0650\u0644\u0627\u0651\u064e \u0628\u0627\u0644\u0644\u0647","meaning":" \u0644\u0627 \u0627\u0646\u062a\u0642\u0627\u0644 \u0648\u0644\u0627 \u062a\u062d\u0648\u0644 \u0645\u0646 \u062d\u0627\u0644 \u0625\u0644\u0649 \u062d\u0627\u0644\u060c \u0648\u0644\u0627 \u0642\u0648\u0629 \u0639\u0644\u0649 \u0634\u064a\u0621 \u0645\u0646 \u0627\u0644\u0623\u0634\u064a\u0627\u0621 \u0625\u0644\u0627 \u0628\u0639\u0648\u0646 \u0645\u0646 \u0627\u0644\u0644\u0647."},{"word":"\u064a\u064f\u0642\u064e\u0627\u0644 \u0644\u0647","meaning":" \u064a\u062d\u062a\u0645\u0644 \u0627\u0644\u0642\u0627\u0626\u0644 \u0647\u0648 \u0627\u0644\u0628\u0627\u0631\u064a -\u062c\u0644 \u0641\u064a \u0639\u0644\u0627\u0647-\u060c \u0623\u0648 \u0645\u0644\u0643 \u064a\u0623\u0645\u0631\u0647 \u0627\u0644\u0644\u0647 -\u0639\u0632 \u0648\u062c\u0644-."},{"word":"\u0647\u064f\u062f\u0650\u064a\u062a\u064e \u0648\u064e\u0643\u064f\u0641\u0650\u064a\u062a\u064e","meaning":" \u0623\u064a: \u0628\u0627\u0633\u062a\u0639\u0627\u0646\u062a\u0643 \u0628\u0627\u0633\u0645\u0647 -\u062a\u0639\u0627\u0644\u0649- \u0648\u062a\u062d\u0635\u0646\u0643 \u0628\u0647 \u0647\u062f\u064a\u062a \u0644\u0644\u0635\u0631\u0627\u0637 \u0627\u0644\u0645\u0633\u062a\u0642\u064a\u0645\u060c \u0648\u0643\u0641\u064a\u062a \u0643\u0644 \u0645\u0647\u0645 \u062f\u0646\u064a\u0648\u064a \u0648\u0623\u062e\u0631\u0648\u064a."},{"word":"\u0648\u064f\u0642\u0650\u064a\u062a\u064e","meaning":" \u062d\u064f\u0641\u0650\u0638\u062a \u0645\u0646 \u0643\u0644 \u0645\u0643\u0631\u0648\u0647."},{"word":"\u062a\u064e\u0646\u064e\u062d\u0651\u064e\u0649","meaning":" \u0645\u064e\u0627\u0644 \u0639\u0646 \u062c\u0647\u062a\u0647\u060c \u0648\u0627\u0628\u062a\u0639\u062f \u0639\u0646 \u0637\u0631\u064a\u0642\u0647."},{"word":"\u0627\u0644\u0634\u0651\u064e\u064a\u0637\u064e\u0627\u0646","meaning":" \u0645\u0646 \u0627\u0644\u0634\u064e\u0637\u064e\u0646: \u0627\u0644\u0628\u064f\u0639\u062f\u060c \u0623\u064a \u0627\u0644\u0628\u0639\u062f \u0639\u0646 \u0643\u0644 \u062e\u064a\u0631\u060c \u0648\u0627\u0644\u0634\u064a\u0637\u0627\u0646 \u0645\u0639\u0631\u0648\u0641\u060c \u0648\u0643\u0644 \u0639\u0627\u062a \u0645\u062a\u0645\u0631\u062f \u0645\u0646 \u0627\u0644\u062c\u0646 \u0648\u0627\u0644\u0625\u0646\u0633 \u0648\u0627\u0644\u062f\u0648\u0627\u0628 \u064a\u0642\u0627\u0644 \u0644\u0647 \u0634\u064a\u0637\u0627\u0646."}],"attribution_ar":"\u0631\u0648\u0627\u0647 \u0623\u0628\u0648 \u062f\u0627\u0648\u062f \u0648\u0627\u0644\u062a\u0631\u0645\u0630\u064a","grade_ar":"\u0635\u062d\u064a\u062d"}