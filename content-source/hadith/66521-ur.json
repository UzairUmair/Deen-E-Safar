645\u064e \u0642\u064e\u0627\u0644\u064e: \u00ab\u0625\u0650\u0646\u0651\u064e \u0627\u0644\u0644\u0647\u064e \u0643\u064e\u062a\u064e\u0628\u064e \u0627\u0644\u0652\u0625\u0650\u062d\u0652\u0633\u064e\u0627\u0646\u064e \u0639\u064e\u0644\u064e\u0649 \u0643\u064f\u0644\u0651\u0650 \u0634\u064e\u064a\u0652\u0621\u064d\u060c \u0641\u064e\u0625\u0650\u0630\u064e\u0627 \u0642\u064e\u062a\u064e\u0644\u0652\u062a\u064f\u0645\u0652 \u0641\u064e\u0623\u064e\u062d\u0652\u0633\u0650\u0646\u064f\u0648\u0627 \u0627\u0644\u0642\u0650\u062a\u0652\u0644\u064e\u0629\u064e\u060c \u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0630\u064e\u0628\u064e\u062d\u0652\u062a\u064f\u0645\u0652 \u0641\u064e\u0623\u064e\u062d\u0652\u0633\u0650\u0646\u064f\u0648\u0627 \u0627\u0644\u0630\u0651\u0650\u0628\u0652\u062d\u064e\u0629\u064e\u060c \u0648\u064e\u0644\u0652\u064a\u064f\u062d\u0650\u062f\u0651\u064e \u0623\u064e\u062d\u064e\u062f\u064f\u0643\u064f\u0645\u0652 \u0634\u064e\u0641\u0652\u0631\u064e\u062a\u064e\u0647\u064f\u060c \u0648\u064e\u0644\u0652\u064a\u064f\u0631\u0650\u062d\u0652 \u0630\u064e\u0628\u0650\u064a\u062d\u064e\u062a\u064e\u0647\u064f\u00bb.","hadeeth_intro_ar":"\u0639\u064e\u0646\u0652 \u0623\u064e\u0628\u0650\u064a \u064a\u064e\u0639\u0652\u0644\u064e\u0649 \u0634\u064e\u062f\u0651\u064e\u0627\u062f\u0650 \u0628\u0652\u0646\u0650 \u0623\u064e\u0648\u0652\u0633\u064d \u0631\u064e\u0636\u0650\u064a\u064e \u0627\u0644\u0644\u0651\u064e\u0647\u064f \u0639\u064e\u0646\u0652\u0647\u064f \u0639\u064e\u0646\u0652 \u0631\u064e\u0633\u064f\u0648\u0644\u0650 \u0627\u0644\u0644\u0651\u064e\u0647\u0650 \u0635\u064e\u0644\u0651\u064e\u0649 \u0627\u0644\u0644\u0647\u064f \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650 \u0648\u064e\u0633\u064e\u0644\u0651\u064e\u0645\u064e \u0642\u064e\u0627\u0644\u064e:","explanation_ar":"\u064a\u064f\u062e\u0628\u0631\u064f \u0627\u0644\u0646\u0628\u064a\u0651\u064f \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645 \u0623\u0646 \u0627\u0644\u0644\u0647 \u062a\u0639\u0627\u0644\u0649 \u0623\u0648\u062c\u0628\u064e \u0639\u0644\u064a\u0646\u0627 \u0627\u0644\u0625\u062d\u0633\u0627\u0646\u064e \u0641\u064a \u0643\u0644 \u0627\u0644\u0623\u0634\u064a\u0627\u0621\u060c \u0648\u0627\u0644\u0625\u062d\u0633\u0627\u0646: \u0647\u0648 \u0645\u0631\u0627\u0642\u0628\u0629 \u0627\u0644\u0644\u0647 \u0639\u0644\u0649 \u0627\u0644\u062f\u0648\u0627\u0645\u060c \u0641\u064a \u0639\u0628\u0627\u062f\u062a\u0647 \u0648\u0641\u064a \u0628\u0630\u0644 \u0627\u0644\u062e\u064a\u0631 \u0648\u0643\u0641 \u0627\u0644\u0623\u0630\u0649 \u0639\u0646 \u0627\u0644\u0645\u062e\u0644\u0648\u0642\u064a\u0646\u060c \u0648\u0645\u0646 \u0630\u0644\u0643 \u0627\u0644\u0625\u062d\u0633\u0627\u0646 \u0641\u064a \u0627\u0644\u0642\u062a\u0644 \u0648\u0627\u0644\u0630\u0628\u062d.\n\u0641\u0627\u0644\u0625\u062d\u0633\u0627\u0646 \u0641\u064a \u0627\u0644\u0642\u062a\u0644 \u0639\u0646\u062f \u0627\u0644\u0642\u0635\u0627\u0635: \u0628\u0623\u0646 \u064a\u062e\u062a\u0627\u0631 \u0623\u0633\u0647\u0644\u064e \u0627\u0644\u0637\u0651\u064f\u0631\u064f\u0642 \u0648\u0623\u062e\u064e\u0641\u0651\u064e\u0647\u0627 \u0648\u0623\u0633\u0631\u0639\u064e\u0647\u0627 \u0632\u0647\u0648\u0642\u064b\u0627 \u0644\u0644\u0645\u0642\u062a\u0648\u0644.\n\u0648\u0627\u0644\u0625\u062d\u0633\u0627\u0646 \u0641\u064a \u0627\u0644\u0630\u0628\u062d \u0639\u0646\u062f \u0627\u0644\u0630\u0643\u0627\u0629: \u0628\u0623\u0646 \u064a\u0631\u0641\u0642 \u0628\u0627\u0644\u0628\u0647\u064a\u0645\u0629 \u0628\u0625\u062d\u062f\u0627\u062f \u0627\u0644\u0622\u0644\u0629\u060c \u0648\u0623\u0644\u0651\u0627 \u062a\u064f\u062d\u064e\u062f\u0651\u064e \u0623\u0645\u0627\u0645 \u0627\u0644\u0630\u0628\u064a\u062d\u0629 \u0648\u0647\u064a \u062a\u0646\u0638\u0631 \u0625\u0644\u064a\u0647\u0627\u060c \u0648\u0623\u0644\u0651\u064e\u0627 \u062a\u064f\u0630\u0628\u062d \u0648\u0647\u0646\u0627\u0643 \u0645\u0646 \u0627\u0644\u0645\u0627\u0634\u064a\u0629 \u0645\u0627 \u064a\u0646\u0638\u0631 \u0625\u0644\u064a\u0647\u0627.","hints_ar":["\u0631\u062d\u0645\u0629 \u0627\u0644\u0644\u0647 \u0639\u0632\u0651 \u0648\u062c\u0644 \u0648\u0644\u0637\u0641\u0647 \u0628\u0627\u0644\u062e\u0644\u0642.","\u0625\u062d\u0633\u0627\u0646 \u0627\u0644\u0642\u062a\u0644 \u0648\u0627\u0644\u0630\u0628\u062d \u0628\u0623\u0646 \u064a\u0643\u0648\u0646 \u0639\u0644\u0649 \u0627\u0644\u0648\u062c\u0647 \u0627\u0644\u0645\u0634\u0631\u0648\u0639.","\u0643\u0645\u0627\u0644 \u0627\u0644\u0634\u0631\u064a\u0639\u0629 \u0648\u0627\u0634\u062a\u0645\u0627\u0644\u0647\u0627 \u0639\u0644\u0649 \u0643\u0644 \u062e\u064a\u0631\u060c \u0648\u0645\u0646 \u0630\u0644\u0643 \u0631\u062d\u0645\u0629 \u0627\u0644\u062d\u064a\u0648\u0627\u0646 \u0648\u0627\u0644\u0631\u0641\u0642 \u0628\u0647.","\u0627\u0644\u0646\u0647\u064a \u0639\u0646 \u0627\u0644\u0645\u064f\u062b\u0652\u0644\u0629 \u0628\u0627\u0644\u0625\u0646\u0633\u0627\u0646 \u0628\u0639\u062f \u0642\u062a\u0644\u0647.","\u062a\u062d\u0631\u064a\u0645 \u0643\u0644 \u0645\u0627 \u0641\u064a\u0647 \u062a\u0639\u0630\u064a\u0628 \u0644\u0644\u062d\u064a\u0648\u0627\u0646."],"words_meanings_ar":[],"attribution_ar":"\u0631\u0648\u0627\u0647 \u0645\u0633\u0644\u0645","grade_ar":"\u0635\u062d\u064a\u062d"}