{"code":200,"status":"OK","data":{"count":2,"matches":[{"number":885,"text":"[He is] the cleaver of daybreak and has made the night for rest and the sun and moon for calculation. That is the determination of the Exalted in Might, the Knowing.","edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","type":"translation"},"surah":{"number":6,"name":"سُورَةُ الأَنۡعَامِ","englishName":"Al-An'aam","englishNameTranslation":"The Cattle","revelationType":"Meccan"},"numberInSurah":96},{"number":6226,"text":"Say, \"I seek refuge in the Lord of daybreak","edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","type":"translation"},"surah":{"number":113,"name":"سُورَةُ الفَلَقِ","englishName":"Al-Falaq","englishNameTranslation":"The Dawn","revelationType":"Meccan"},"numberInSurah":1}]}}